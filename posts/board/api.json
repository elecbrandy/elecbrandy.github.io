              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Interaction-Controller"
        ],
        "summary": "게시글 좋아요 취소",
        "operationId": "removeLike",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts/{postId}/comments": {
      "post": {
        "tags": [
          "Comment-Controller"
        ],
        "summary": "댓글 작성",
        "operationId": "createComment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "postId",
            "in": "path",

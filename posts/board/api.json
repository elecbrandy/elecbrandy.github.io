{
  "openapi": "3.0.1",
  "info": {
    "title": "Spring Boot Board API (Common Response)",
    "description": "게시판 서비스 API 명세서 - 모든 응답은 CommonResponse 래퍼로 감싸져서 200 OK로 반환됩니다.",
    "version": "v1.1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CommonResponse": {
        "type": "object",
        "description": "API 공통 응답 규격. HTTP 200 OK 내에서 논리적 성공/실패를 구분합니다.",
        "properties": {
          "status": {
            "type": "string",
            "example": "success",
            "description": "응답 상태 (success, fail, error)"
          },
          "message": {
            "type": "string",
            "example": "요청이 성공적으로 처리되었습니다.",
            "description": "응답 메시지 또는 에러 상세 내용"
          },
          "data": {
            "type": "object",
            "description": "실제 데이터 페이로드 (실패 시 null 가능)"
          }
        }
      },
      "SignUpRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "username"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "PostRequest": {
        "type": "object",
        "required": [
          "categoryId",
          "title",
          "content"
        ],
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "CommentRequest": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": [
          "Auth-Controller"
        ],
        "summary": "회원가입",
        "operationId": "signUp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK (Created)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth-Controller"
        ],
        "summary": "로그인 (JWT 발급)",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": [
          "User-Controller"
        ],
        "summary": "내 정보 조회",
        "operationId": "getMyInfo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/{userId}/follows": {
      "post": {
        "tags": [
          "User-Controller"
        ],
        "summary": "유저 팔로우",
        "operationId": "followUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": [
          "Category-Controller"
        ],
        "summary": "카테고리 목록 조회",
        "operationId": "getCategories",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories/{categoryId}/favorites": {
      "post": {
        "tags": [
          "Category-Controller"
        ],
        "summary": "카테고리 즐겨찾기 추가",
        "operationId": "addCategoryFavorite",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts": {
      "post": {
        "tags": [
          "Post-Controller"
        ],
        "summary": "게시글 작성",
        "operationId": "createPost",
        "security": [
          {
            "bearerAuth": []
